{
  "name": "ozon-tilda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/main.ts",
    "build": "tsc -p server/tsconfig.json",
    "start": "node server/dist/main.js",
    "setup": "node server/dist/cli/setup.js",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "hono": "4.6.14",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
