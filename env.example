# Пример .env. На сервере его создаёт deploy/install.sh, дальше правит команда ozon-tilda setup.
NODE_ENV=production
BASE_PATH=/ozon-tilda
# Адрес сервера (поддомен магазина) и внешний адрес сервиса.
DOMAIN=
PUBLIC_URL=http://localhost:3000/ozon-tilda
POSTGRES_PASSWORD=

# Ozon Delivery API. mock — тестовые цены без ключей; live — настоящий расчёт.
OZON_MODE=mock
OZON_DELIVERY_CLIENT_ID=
OZON_DELIVERY_CLIENT_SECRET=
# Номер с аккаунтом Ozon в формате +79XXXXXXXXX: без него Ozon не считает цену.
OZON_SERVICE_PHONE=
OZON_MISSES_PER_HOUR=300
# Шифрование ключей Ozon в базе (32 байта base64), генерируется при установке.
SHOP_KEYS_KEY=
